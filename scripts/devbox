#!/usr/bin/env bash
#
# devbox — run the dotfiles' dev container over whatever checkout you are in.
#
# The devcontainer config lives in the dotfiles (containers/devcontainer), not in
# the repo being worked on: one definition, one image, one set of shared caches
# and logins, and no `.devcontainer/` to add to somebody else's project. This
# script is what joins the two — it points the devcontainer CLI at that config
# with `--workspace-folder` set to your pwd, and derives everything the config
# needs from that path:
#
#   DEVBOX_WORKSPACE       the checkout, on the host
#   DEVBOX_WORKSPACE_SLUG  the same path minus $HOME — the workspace path in the
#                          container is /workspaces/<slug>, so every checkout has
#                          a distinct one (see devcontainer.json)
#   DEVBOX_PROFILE         the projects/<name> profile matching this path
#   DEVBOX_STATE           per-workspace state: the generated compose override,
#                          the staged Claude Code skills
#   COMPOSE_PROJECT_NAME   read by the devcontainer CLI, so two checkouts never
#                          share a container
#
# All of them are derived, never stored, so any subcommand run from the same
# directory resolves to the same container.
#
# Usage: devbox [--profile <name>] [--workspace <path>] <command> [args...]
#
#   up            create/start the container for this workspace
#   shell         a shell inside it (default: zsh)
#   exec CMD...   run a command inside it
#   claude ARGS   run Claude Code with --dangerously-skip-permissions
#   stop          stop the container, keep it
#   down          stop and remove it (shared caches and logins survive)
#   rebuild       recreate it from scratch (--no-cache to rebuild the image too)
#   status        what is running for this workspace
#   env           print everything resolved for this workspace
#
# `shell`, `exec` and `claude` start the container first if it is not running.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
DEVBOX_HOME="$(cd "$(dirname "$self")/../containers/devcontainer" && pwd)"
config="$DEVBOX_HOME/devcontainer.json"

exists() { command -v "$1" >/dev/null 2>&1; }

log() { printf '\033[1;34m[devbox]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[devbox] WARNING:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[devbox] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# The header comment above is the help text: everything from the third line up to
# the first line that isn't a comment, so editing one keeps the other honest.
usage() {
	awk 'NR > 2 { if ($0 !~ /^#/) exit; sub(/^#( |$)/, ""); print }' "$self"
	exit "${1:-0}"
}

# --- Arguments ----------------------------------------------------------------

workspace="$PWD"
profile="${DEVBOX_PROFILE:-}"

while [ $# -gt 0 ]; do
	case "$1" in
	--profile) profile="${2:?--profile needs a name}"; shift 2 ;;
	--workspace) workspace="${2:?--workspace needs a path}"; shift 2 ;;
	-h | --help) usage ;;
	--) shift; break ;;
	-*) die "unknown option: $1 (try --help)" ;;
	*) break ;;
	esac
done

cmd="${1:-}"
[ $# -gt 0 ] && shift || true
[ -n "$cmd" ] || usage 1

command -v docker >/dev/null || die "docker is not installed"
command -v devcontainer >/dev/null ||
	die "the devcontainer CLI is not installed — \`volta install @devcontainers/cli\`"

# --- Everything derived from the workspace path -------------------------------

workspace="$(cd "$workspace" 2>/dev/null && pwd -P)" || die "no such directory: $workspace"

# The container's workspace path is /workspaces/<slug>. Relative to $HOME when it
# is under it, which keeps the path both readable and unique — the checkout's own
# name stays the leaf, so it is what shows up in the shell prompt.
case "$workspace" in
"$HOME"/*) slug="${workspace#"$HOME"/}" ;;
*) slug="${workspace#/}" ;;
esac

# Compose project name: the checkout's directory name for readability, plus a
# hash of the full path for uniqueness — two repos with a `main` worktree each
# must not land in the same project. Must match [a-z0-9][a-z0-9_-]*.
hash="$(printf '%s' "$workspace" | sha256sum | cut -c1-8)"
leaf="$(basename "$workspace" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')"
leaf="${leaf%-}"
project="devbox-${leaf:-workspace}-$hash"

if [ -z "$profile" ]; then
	source "$DEVBOX_HOME/scripts/lib/profile.sh"
	profile="$(profile_resolve "$workspace")"
fi
[ -d "$DEVBOX_HOME/projects/$profile" ] || warn "no profile directory projects/$profile"

state="${XDG_STATE_HOME:-$HOME/.local/state}/devbox/$project"

export DEVBOX_HOME
export DEVBOX_WORKSPACE="$workspace"
export DEVBOX_WORKSPACE_SLUG="$slug"
export DEVBOX_PROFILE="$profile"
export DEVBOX_STATE="$state"
export COMPOSE_PROJECT_NAME="$project"

# devcontainer.json includes $DEVBOX_STATE/docker-compose.overrides.yml, which
# initializeCommand is what actually writes — but the CLI reads the compose files
# to work out what to build, and on a first run that file does not exist yet.
# A valid empty stub costs nothing and keeps the first `up` from failing on it.
#
# Called only by the subcommands that invoke the CLI, so `status` and `env` stay
# free of side effects on a workspace that has never been up.
prepare_state() {
	mkdir -p "$state"
	[ -f "$state/docker-compose.overrides.yml" ] && return 0
	printf 'services:\n  app: {}\n' >"$state/docker-compose.overrides.yml"
}

# --- Talking to the container -------------------------------------------------

# The flags go immediately after the subcommand, never at the end: `exec` takes
# the command to run as a positional, and anything after it is passed through as
# that command's own arguments — a trailing --config is simply ignored, and the
# CLI then looks for a .devcontainer/ in the workspace that isn't there.
dc() {
	local sub="$1"
	shift
	devcontainer "$sub" --workspace-folder "$workspace" --config "$config" "$@"
}

running() {
	[ -n "$(docker ps -q --filter "label=com.docker.compose.project=$project" 2>/dev/null)" ]
}

ensure_up() {
	running && return 0
	log "container is not running — starting it"
	prepare_state
	dc up
}

# `docker compose` finds a project by label, so no -f is needed for anything that
# operates on what is already there.
compose() { docker compose -p "$project" "$@"; }

case "$cmd" in
up)
	log "workspace $workspace"
	log "profile   $profile"
	log "project   $project"
	prepare_state
	dc up "$@"
	;;

rebuild)
	extra=()
	for arg in "$@"; do
		[ "$arg" = "--no-cache" ] && extra+=(--build-no-cache)
	done
	log "recreating $project"
	prepare_state
	# --remove-existing-container is what makes this a rebuild rather than a
	# restart: create-time hooks (on-create, the profile's setup.sh) run again.
	dc up --remove-existing-container "${extra[@]}"
	;;

shell)
	ensure_up
	if [ $# -gt 0 ]; then
		dc exec zsh -lc "$*"
	else
		dc exec zsh
	fi
	;;

exec)
	[ $# -gt 0 ] || die "exec needs a command"
	ensure_up
	dc exec "$@"
	;;

claude)
	ensure_up
	# The whole point of the egress firewall: no permission prompt reviews a tool
	# call, but the call runs in a container that can only reach the allowlist,
	# as a non-root user (the CLI refuses this flag as root). See the README.
	exists herdr && export HERDR_AGENT=claude
	dc exec claude --dangerously-skip-permissions "$@"
	;;

stop)
	log "stopping $project"
	compose stop
	;;

down)
	log "removing $project"
	# No -v: the shared caches and logins are external volumes and out of reach
	# either way, but a profile's per-workspace volumes (node_modules and the
	# like) are not, and they are expensive to rebuild.
	compose down
	;;

status)
	log "workspace $workspace"
	log "profile   $profile"
	log "project   $project"
	compose ps
	;;

env)
	printf 'DEVBOX_HOME=%s\n' "$DEVBOX_HOME"
	printf 'DEVBOX_WORKSPACE=%s\n' "$DEVBOX_WORKSPACE"
	printf 'DEVBOX_WORKSPACE_SLUG=%s\n' "$DEVBOX_WORKSPACE_SLUG"
	printf 'DEVBOX_PROFILE=%s\n' "$DEVBOX_PROFILE"
	printf 'DEVBOX_STATE=%s\n' "$DEVBOX_STATE"
	printf 'COMPOSE_PROJECT_NAME=%s\n' "$COMPOSE_PROJECT_NAME"
	printf 'container workspace=/workspaces/%s\n' "$DEVBOX_WORKSPACE_SLUG"
	;;

*)
	die "unknown command: $cmd (try --help)"
	;;
esac
