// Waybar replaces i3bar and i3status in the Hyprland session. The module list
// follows the i3status order: the machine load first, then the network, the
// volume, the battery and the clock.
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 8,

    // The window title sits next to the workspace numbers, not in the centre.
    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-right": ["cpu", "temperature", "memory", "disk", "network", "pulseaudio", "battery", "tray", "clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    // The name of the active submap, which is how the resize mode and the
    // system mode announce themselves. Hidden while no submap is active.
    "hyprland/submap": {
        "format": "[{}]",
        "tooltip": false
    },

    "hyprland/window": {
        "max-length": 80,
        "separate-outputs": true
    },

    // The four load modules refresh every 5 seconds, the i3status interval.
    // A click on any of them opens btop, which shows the detail the bar omits.
    "cpu": {
        "format": "CPU {usage}% {load}",
        "interval": 5,
        "on-click": "wezterm start -- btop"
    },

    // The package sensor of the CPU, the sensor i3status reads as
    // cpu_temperature 0. The hwmon number changes between boots, so the path
    // stops at the parent directory and waybar finds the number.
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "{temperatureC}°C",
        "critical-threshold": 85,
        "interval": 5,
        "on-click": "wezterm start -- btop"
    },

    "memory": {
        "format": "MEM {used:0.1f}G ({percentage}%)⊂{total:0.1f}G",
        "interval": 5,
        "on-click": "wezterm start -- btop"
    },

    "disk": {
        "path": "/",
        "format": "🖴: {free} ({percentage_free}%)⊂{total}",
        "interval": 30,
        "on-click": "wezterm start -- btop"
    },

    // No tray applet runs, so this module is the whole interface to
    // NetworkManager. nmtui ships with network-manager.
    "network": {
        "format-wifi": "W: {essid} {signalStrength}%",
        "format-ethernet": "E: {ipaddr}",
        "format-disconnected": "W: down",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "wezterm start -- nmtui"
    },

    "pulseaudio": {
        "format": "♪: {volume}%",
        "format-muted": "♪: muted",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {time}",
        "format-charging": "CHR {capacity}% {time}",
        "format-full": "FULL",
        "format-time": "{H}:{m}",
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "spacing": 8
    },

    // The 5 second interval matches the load modules. The seconds field
    // therefore steps by 5, not by 1.
    "clock": {
        "interval": 5,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
