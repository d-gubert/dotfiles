;; Home-row mod aliases for Debian and Ubuntu. common/.config/kanata/kanata.kbd
;; includes this file and defines everything else.
;;
;; `(multi f24 ...)` presses a spare key together with the modifier. The
;; desktop sees no lone modifier tap, so a held `a` does not open the GNOME
;; overview and a held `s` does not focus a GTK menu bar.
;;
;; This is safe only while xkeyboard-config leaves keycode 202 without a
;; keysym, because then no application receives F24. A newer xkeyboard-config
;; maps that keycode to F24 and breaks the terminal. Read
;; arch/.config/kanata/mods.kbd before you copy this file to another machine.
(defalias
  a (multi f24 (tap-hold $tap-time $hold-time a lmet))
  s (multi f24 (tap-hold $tap-time $hold-time s lalt))
  d (multi f24 (tap-hold $tap-time $hold-time d lctl))
  f (multi f24 (tap-hold $tap-time $hold-time f lsft))
  j (multi f24 (tap-hold $tap-time $hold-time j rsft))
  k (multi f24 (tap-hold $tap-time $hold-time k rctl))
  l (multi f24 (tap-hold $tap-time $hold-time l lalt))
  ; (multi f24 (tap-hold $tap-time $hold-time ; rmet))
)

;; The top row and fn pass through unchanged. Only macOS remaps them; see
;; mac/.config/kanata/mods.kbd.
(defalias
  fn fn
  f1 f1  f2 f2  f3 f3  f4 f4  f5 f5  f6 f6
  f7 f7  f8 f8  f9 f9  f10 f10  f11 f11  f12 f12
)
