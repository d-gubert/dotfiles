{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${DOTFILES_PATH}\"/scripts/tmux-window-status.sh busy-done --ignore-on-active-pane" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "\"${DOTFILES_PATH}\"/scripts/tmux-window-status.sh attention --ignore-on-active-pane" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${DOTFILES_PATH}\"/scripts/tmux-window-status.sh clear" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${DOTFILES_PATH}\"/scripts/tmux-window-status.sh clear" }
        ]
      }
    ]
  }
}
