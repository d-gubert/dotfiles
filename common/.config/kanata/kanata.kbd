;; Home-row mods. Shared between Linux and macOS — lmet/rmet resolve to Super
;; on Linux and Command on macOS, which is the key you want in that position on
;; either platform, so no per-OS variant is needed.
;;
;; macOS additionally needs Karabiner's VirtualHIDDevice driver and Input
;; Monitoring permission; `make install-kanata` installs it and prints what
;; still has to be approved by hand.
;;
;; The aliases live in mods.kbd, because one of them does differ by OS. Each
;; stow package carries its own copy, so stow selects the variant. kanata
;; resolves an include against the directory of the config file it opened, and
;; that directory is ~/.config/kanata, not this repository. The symlink that
;; stow puts there does not change the lookup. arch/.config/kanata/mods.kbd
;; explains what differs and why.

;; defsrc is still necessary
;;
;; On macOS kanata grabs only the internal keyboard. The Glove80 has its own
;; home-row mods, and kanata must not apply them a second time. An exclude
;; cannot name the Glove80: over Bluetooth kanata reads its name as garbage,
;; and it shares its vendor and product IDs with the Karabiner virtual
;; keyboard. Linux ignores this option.
(defcfg
  process-unmapped-keys yes
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defsrc
  a s d f j k l ;
)
(defvar
  tap-time 150
  hold-time 200
)

;; defvar must come first — the included aliases read $tap-time and $hold-time.
(include "mods.kbd")

(deflayer base
  @a @s @d @f @j @k @l @;
)
