# host:container, one per line.
#
# Running two workspaces of this profile at once needs no change here: the second
# one finds 3000 taken and publishes 3001 instead, and says so. Pin the host port
# with DEVBOX_PORTS="3100:3000" devbox up when you want a specific one.
3000:3000

# 3001 was Meteor's bundled mongod, which it starts itself and ONLY while
# MONGO_URL is unset. `env` now sets it — the workspace uses the shared MongoDB
# from containers/local-mongo instead — so nothing listens on 3001 and
# publishing it would only reserve a host port for nothing. Uncomment it
# together with the MONGO_URL/MONGO_OPLOG_URL block in `env` to go back to the
# bundled database.
#3001:3001
