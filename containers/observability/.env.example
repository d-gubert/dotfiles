# Copy to .env and tweak as needed. Compose reads .env automatically.

# Image versions
OTEL_COLLECTOR_VERSION=0.116.0
PROMETHEUS_VERSION=v3.1.0
GRAFANA_VERSION=11.4.0

# Prometheus on-disk retention
PROMETHEUS_RETENTION=15d

# Grafana admin login (http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
