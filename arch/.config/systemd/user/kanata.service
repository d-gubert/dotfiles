# kanata remaps the keyboard, so it has to run for the whole login session and
# not only while Hyprland runs. A user unit starts it at login, before the
# compositor, and restarts it if it dies.
#
# kanata needs /dev/uinput. system/etc/modules-load.d/uinput.conf loads the
# module at boot and the udev rule opens the node to the uinput group, so the
# device is ready long before this unit starts. The user manager inherits the
# supplementary groups of the login session, which is where the uinput group
# comes from.

[Unit]
Description=kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Type=simple
# The default search path is the current directory first, and a user unit has
# no useful one, so name the config file.
ExecStart=/usr/bin/kanata --cfg %h/.config/kanata/kanata.kbd
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
